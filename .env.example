# ==============================================================================
# GADGET COMMERCE PLATFORM (GCP) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database (Neon PostgreSQL)
# Pooled connection URL for regular application workloads
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.neon.tech/gcp_production?sslmode=require"
# Direct unpooled connection URL for Drizzle migrations & session operations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.neon.tech/gcp_production?sslmode=require"

# Neon Project Context
NEON_ORGANIZATION_ID="org-dark-union-91210516"
NEON_PROJECT_ID="weathered-frost-63147361"
NEON_TARGET_BRANCH="production"
NEON_BRANCH="production"

# Neon Auth Configuration
NEON_AUTH_BASE_URL="https://auth.neon.tech/projects/weathered-frost-63147361"
NEON_AUTH_JWKS_URL="https://auth.neon.tech/projects/weathered-frost-63147361/.well-known/jwks.json"
JWT_SECRET="super-secret-jwt-key-minimum-32-characters-for-fallback"

# Neon AI Gateway
NEON_AI_GATEWAY_BASE_URL="https://ai.neon.tech/projects/weathered-frost-63147361/v1"
NEON_AI_GATEWAY_TOKEN="neon_ai_token_placeholder"

# Object Storage (Neon S3-compatible Buckets)
AWS_ACCESS_KEY_ID="neon_bucket_key_id"
AWS_SECRET_ACCESS_KEY="neon_bucket_secret"
AWS_ENDPOINT_URL_S3="https://storage.neon.tech"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="assets"

# Paystack Payment Provider Configuration
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_WEBHOOK_SECRET="sk_test_placeholder"
PAYSTACK_MODE="test"

# Service Ports & URLs
PORT_API=4000
PORT_STOREFRONT=3000
PORT_RETAIL_ADMIN=3001
PORT_PLATFORM_ADMIN=3002

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_PAYSTACK_KEY="pk_test_placeholder"
NEXT_PUBLIC_DEFAULT_TENANT_ID="the-gadget-master-gh"

# Redis / Queue Service (Optional local fallback supported)
REDIS_URL="redis://localhost:6379"

# Sentry / Telemetry (Optional)
SENTRY_DSN=""
NODE_ENV="development"
